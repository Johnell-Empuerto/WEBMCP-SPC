# ════════════════════════════════════════════════════════════════════════════
# NXPERT EON backend environment template.
#
# Copy this file to eon_backend/.env and fill in REAL values.
# eon_backend/.env is git-ignored — NEVER commit real secrets.
#
# Required (the server will refuse to start without them):
#   DB_PASSWORD, JWT_SECRET
#
# See docs/SECURITY.md for the full environment-variable policy.
# ════════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3002
# development | production
NODE_ENV=development

# ── Database (SQL Server) ───────────────────────────────────────────────────
DB_SERVER=iot-server
DB_DATABASE=NXPERT_EON
DB_USER=sa
# REQUIRED — the real SQL Server password goes in eon_backend/.env only.
DB_PASSWORD=your_db_password
DB_PORT=1433
# Optional connection pool tuning
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Authentication (JWT) ────────────────────────────────────────────────────
# REQUIRED — a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret
# Access token lifetime (seconds, or a duration string like '8h')
JWT_EXPIRES_IN=28800
# Refresh token lifetime (seconds, or a duration string like '7d')
JWT_REFRESH_EXPIRES_IN=604800

# ── CORS ────────────────────────────────────────────────────────────────────
# The frontend origin(s) allowed to call this API. In production set this to
# the real frontend URL. Never use '*' with credentials.
CORS_ORIGIN=http://192.168.0.103:5173

# ── Node-RED (health check only, read-only GET) ─────────────────────────────
# Used ONLY by GET /api/health. Leave empty to report "not configured".
NODE_RED_URL=http://iot-server:1880/

# ── API rate limiting (global) ──────────────────────────────────────────────
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=500
